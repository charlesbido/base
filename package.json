{
  "name": "camp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Camp — a Basecamp-style project collaboration tool",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "pnpm -C web build",
    "typecheck": "tsc -p tsconfig.test.json && pnpm -C web typecheck",
    "dev": "tsx watch src/server.ts",
    "dev:web": "pnpm -C web dev",
    "start": "node dist/server.js",
    "mcp:stdio": "tsx src/mcp-stdio.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "vhost": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/vhost": "^3.0.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.11"
  }
}
